*.sh text eol=lf
*.patch text eol=lf
# Files installed on the Pi keep Linux line endings on every checkout.
scripts/pi-system/** text eol=lf
scripts/systemd/** text eol=lf
# Generated bundles: never rewrite their line endings.
ultraskelly/ui/dashboard/vendor/** -text
# Downloaded calibration files keep their exact bytes (their hashes are recorded).
ultraskelly/calibration/** -text
